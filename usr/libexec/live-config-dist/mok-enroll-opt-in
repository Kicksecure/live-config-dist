## Opt-in Secure Boot MOK setup during a Calamares install, OFF by default.
## Enabled only when the MOK_ENROLL environment variable is set (propagated from
## install-host via 'sudo --preserve-env' and preserved across the chroot). Then,
## and only on an EFI/UEFI install, it creates the per-machine MOK and signs the
## DKMS modules (e.g. tirdad) so the public cert at /var/lib/dkms/mok.pub can be
## enrolled afterwards: a test harness via 'VBoxManage modifynvram enrollmok', or a
## user via 'shim-manage-mok --enroll'. It deliberately does NOT run
## 'mokutil --import' -- that queues the interactive MokManager prompt at the next
## boot. Unset (the default) -> no key, no prompt, reproducible image.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## Record the decision on the TARGET (the Calamares session log lives only in the
## live installer session, so without this an install cannot be audited afterwards).
mok_log() {
   printf '%s %s\n' "$(date -u +%FT%TZ 2>/dev/null || true)" "$*" \
      >> /var/log/mok-enroll-opt-in.log 2>/dev/null || true
}
efi_state='no'
if [ -d /sys/firmware/efi ]; then
   efi_state='yes'
fi
mok_log "invoked: MOK_ENROLL=[${MOK_ENROLL:-UNSET}] efi=${efi_state}"

if [ -z "${MOK_ENROLL:-}" ]; then
   mok_log "skip: MOK_ENROLL unset"
   printf '%s\n' "$0: MOK_ENROLL unset; skipping Secure Boot MOK setup (default)."
   exit 0
fi

if [ ! -d /sys/firmware/efi ]; then
   mok_log "skip: not EFI"
   printf '%s\n' "$0: not an EFI/UEFI install; Secure Boot MOK is not applicable; skipping."
   exit 0
fi

mok_log "run: creating MOK + signing DKMS and VirtualBox GA modules"
printf '%s\n' "$0: MOK_ENROLL set and EFI detected; creating MOK and signing out-of-tree modules."
shim-signed-mok-setup
rebuild-dkms-modules
## Sign the Oracle VirtualBox Guest Additions modules too (not DKMS, so the line
## above does not cover them); no-op when the GA is not installed.
rebuild-vbox-ga-modules

## Declare this MOK legitimate (a deliberately generated per-machine key, not a
## vulnerable image-builtin one) so legacy-dist's first-boot scrub and systemcheck's
## check-image-builtin-mok leave it in place for host-side / shim-manage-mok enrollment.
mkdir --parents -- /var/lib/legacy-dist/do_once
touch -- /var/lib/legacy-dist/do_once/mok-ok

mok_pub_state='MISSING'
if [ -f /var/lib/dkms/mok.pub ]; then
   mok_pub_state='present'
fi
mok_log "done: mok.pub ${mok_pub_state}, mok-ok marker set"
printf '%s\n' "$0: done; public cert for enrollment is at /var/lib/dkms/mok.pub."
