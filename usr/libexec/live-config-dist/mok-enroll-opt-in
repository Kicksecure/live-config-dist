## Opt-in Secure Boot MOK setup during a Calamares install, OFF by default.
## Enabled only when the MOK_ENROLL environment variable is set (propagated from
## install-host via 'sudo --preserve-env' and preserved across the chroot). Then,
## and only on an EFI/UEFI install, it creates the per-machine MOK and signs the
## DKMS modules (e.g. tirdad) so the public cert at /var/lib/dkms/mok.pub can be
## enrolled afterwards: a test harness via 'VBoxManage modifynvram enrollmok', or a
## user via 'shim-manage-mok --enroll'. It deliberately does NOT run
## 'mokutil --import' -- that queues the interactive MokManager prompt at the next
## boot. Unset (the default) -> no key, no prompt, reproducible image.

## provides was_executed; a failed load must abort LOUDLY in every invocation mode
## (a 'bash <script>' call ignores the shebang -e), never silently skip main().
# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh (set HELPER_SCRIPTS_PATH)" >&2
   exit 1
fi

## Log, EFI-sysfs and dkms public-cert paths are top-level globals carrying the
## literal production defaults, so a unit test that sources this file can redirect
## them to a temp tree. No env indirection: production is byte-identical.
mok_enroll_log_file='/var/log/mok-enroll-opt-in.log'
efi_sysfs_dir='/sys/firmware/efi'
dkms_mok_public_file='/var/lib/dkms/mok.pub'

## Record the decision on the TARGET (the Calamares session log lives only in the
## live installer session, so without this an install cannot be audited afterwards).
mok_log() {
   printf '%s %s\n' "$(date -u +%FT%TZ 2>/dev/null || true)" "$*" \
      >> "${mok_enroll_log_file}" 2>/dev/null || true
}
mok_enroll_opt_in() {
   efi_state='no'
   if [ -d "${efi_sysfs_dir}" ]; then
      efi_state='yes'
   fi
   mok_log "invoked: MOK_ENROLL=[${MOK_ENROLL:-UNSET}] efi=${efi_state}"

   if [ -z "${MOK_ENROLL:-}" ]; then
      mok_log "skip: MOK_ENROLL unset"
      printf '%s\n' "$0: MOK_ENROLL unset; skipping Secure Boot MOK setup (default)."
      return 0
   fi

   if [ ! -d "${efi_sysfs_dir}" ]; then
      mok_log "skip: not EFI"
      printf '%s\n' "$0: not an EFI/UEFI install; Secure Boot MOK is not applicable; skipping."
      return 0
   fi

   mok_log "run: creating MOK + signing DKMS modules"
   printf '%s\n' "$0: MOK_ENROLL set and EFI detected; creating MOK and signing out-of-tree modules."
   shim-signed-mok-setup
   rebuild-dkms-modules
   ## Oracle VirtualBox Guest Additions modules (not DKMS) are rebuilt+signed by
   ## vbox-guest-installer and by the GA's own vboxadd boot setup, so there is no
   ## separate GA signing step here.

   mok_pub_state='MISSING'
   if [ -f "${dkms_mok_public_file}" ]; then
      mok_pub_state='present'
   fi
   mok_log "done: mok.pub ${mok_pub_state}"
   printf '%s\n' "$0: done; public cert for enrollment is at ${dkms_mok_public_file}."
}

main() {
   set -o errexit
   set -o nounset
   set -o pipefail
   set -o errtrace
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C

   mok_enroll_opt_in "$@"
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
