#!/bin/bash

## Copyright (C) 2020 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Creates an "Install Whonix" or "Install Kicksecure" icon on the live session tested with:
## Xfce, LXDE, LXqt, Gnome, KDE, Mate, Cinnamon

set -x

true "$0: START"

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## We query xdg-user-dir because the Desktop directory has different
## names for different languages
DESKTOP=$(xdg-user-dir DESKTOP)

## Just in case this runs before the xdg folder creation script.
mkdir --parents "${DESKTOP}"

if test -f /usr/share/kicksecure/marker ; then
   project_name="Kicksecure"
elif test -f /usr/share/whonix/marker ; then
   project_name="Whonix-Host"
else
   project_name="unknown-fork"
fi

## Among the Debian desktop environments, LXDE is the only one
## that behaves completely different.
if [ -f /usr/bin/lxsession ]; then
    printf '%s\n' "[Desktop Entry]
Type=Link
Name=Install ${project_name}
Icon=install-${project_name}
URL=/usr/share/applications/install-host.desktop" \
        > "${DESKTOP}"/install-host.desktop
else
    cp /usr/share/applications/install-host.desktop "${DESKTOP}"
    ## Xfce needs this executable otherwise it complains, everything
    ## else doesn't seem to care either way.
    chmod +x "${DESKTOP}"/install-host.desktop
    ## LXQt additionally needs it marked as trusted.
    gio set --type='string' "${DESKTOP}/install-host.desktop" 'metadata::trust' 'true'
fi

## Avoid Xfce "Untrusted application launcher"
## https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1037299
## https://forum.xfce.org/viewtopic.php?id=16357
f="${DESKTOP}"/install-host.desktop
gio set -t string "${f}" metadata::xfce-exe-checksum "$(sha256sum "${f}" | awk '{print $1}')"

## A gvfs metadata write emits no inotify event on the file itself, so a file
## manager that already scanned the Desktop keeps its cached "untrusted"
## FileInfo and still prompts on launch despite metadata::trust (LXQt) /
## metadata::xfce-exe-checksum (Xfce) being set. touch bumps the mtime, which
## does fire inotify, forcing a re-read of the fresh metadata. Matches upstream
## calamares-settings-debian.
touch -- "${f}"

true "$0: END"
